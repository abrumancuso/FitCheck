# FitCheck — Variables de entorno
# Copiá este archivo como .env y completá los valores

# Cloudflare Worker para try-on virtual
# Obtenela deployando worker.js en https://workers.cloudflare.com/
EXPO_PUBLIC_VTON_WORKER_URL=

# ── Probador Virtual (aiFittingService.js) ─────────────────────
# Provider: replicate (default) | fal | proxy
#   replicate → usa EXPO_PUBLIC_REPLICATE_API_TOKEN
#   fal       → usa EXPO_PUBLIC_FAL_KEY
#   proxy     → usa EXPO_PUBLIC_AIFIT_API_BASE (tu worker.js:
#               la API key queda en el servidor, NO en la app)
EXPO_PUBLIC_AIFIT_PROVIDER=replicate
EXPO_PUBLIC_REPLICATE_API_TOKEN=
EXPO_PUBLIC_FAL_KEY=
EXPO_PUBLIC_AIFIT_API_BASE=

# Modelos (opcionales — los defaults funcionan)
# EXPO_PUBLIC_REPLICATE_MODEL=cuuupid/idm-vton
# EXPO_PUBLIC_FAL_MODEL=fal-ai/idm-vton

# remove.bg (remoción de fondo al cargar prendas)
EXPO_PUBLIC_REMOVE_BG_API_KEY=

# Supabase (opcional, si usás Supabase)
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
