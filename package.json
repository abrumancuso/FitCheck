    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "predeploy": "npx expo export --platform web",
    "deploy": "touch dist/.nojekyll && cd dist && git init -b gh-pages -q && (git remote remove origin 2>/dev/null || true) && git remote add origin \"$(git -C .. remote get-url origin)\" && git add -A && (git commit -m \"deploy: FitCheck web build\" -q || true) && git push --force origin gh-pages"
  },
  "private": true,
  "devDependencies": {
    "dotenv": "^17.4.2",
    "gh-pages": "^6.3.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
